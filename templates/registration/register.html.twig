{% extends 'base.html.twig' %}

{% block title %}{{ 'register_prompt_regular.message'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'register_prompt_regular.message'|trans }}</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.username, {
            label: 'username.message'|trans
        }) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'password.message'|trans
        }) }}

        <button type="submit" class="btn">{{ 'register_prompt_regular.message'|trans }}</button>
    {{ form_end(registrationForm) }}
{% endblock %}

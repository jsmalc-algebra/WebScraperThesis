{% extends 'base.html.twig' %}

{% block title %}{{ 'main.menu'|trans }}{% endblock %}

{% block body %}

    {% if app.user %}
        <h2 style="text-align: center"> {{ 'user.menu'|trans({'%username%': app.user.userIdentifier}) }}, <a href="{{ logout_path() }}">{{ 'logout.message'|trans }}</a></h2>
    {% endif %}

    <section>
        <div class="card-grid">
            <a href="{{ path('URL_input') }}" class="menu-card">
                <h3>{{ 'scraping.menu'|trans }}</h3>
                <p>{{ 'webscraping.menu'|trans }}</p>
                <span class="menu-card-cta">{{'choose.menu'|trans}}</span>
            </a>
        </div>
        <div class="card-grid">
            <a href="{{ path('app_user_show', {'username':app.user.userIdentifier}) }}" class="menu-card">
                <h3>{{ 'profile.menu'|trans }}</h3>
                <p>{{ 'profile_explanation.menu'|trans }}</p>
                <span class="menu-card-cta">{{'choose.menu'|trans}}</span>
            </a>
        </div>
       {% if  is_granted('ROLE_ADMIN')%}
           <div class="card-grid">
               <a href="{{ path('app_user_index') }}" class="menu-card">
                   <h3>{{ 'index.user'|trans }}</h3>
                   <p>{{ 'index.menu'|trans }}</p>
                   <span class="menu-card-cta">{{'choose.menu'|trans}}</span>
               </a>
           </div>
           <div class="card-grid">
               <a href="{{ path('app_log') }}" class="menu-card">
                   <h3>{{ 'title.logs'|trans }}</h3>
                   <p>{{ 'logs.menu'|trans }}</p>
                   <span class="menu-card-cta">{{'choose.menu'|trans}}</span>
               </a>
           </div>
       {% endif %}
    </section>

{% endblock %}

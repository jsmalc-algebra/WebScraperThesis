{% extends 'base.html.twig' %}

{% block title %}{{ 'main.menu'|trans }}{% endblock %}

{% block body %}

    {% if app.user %}
        <h2 style="text-align: center"> {{ 'user.menu'|trans({'%username%': app.user.userIdentifier}) }}, <a href="{{ logout_path() }}">{{ 'logout.message'|trans }}</a></h2>
    {% endif %}

    <section>
        <div class="card-grid">
            <a href="{{ path('URL_input') }}" class="menu-card">
                <h3>{{ 'scraping.menu'|trans }}</h3>
                <p>{{ 'webscraping.menu'|trans }}</p>
                <span class="menu-card-cta">{{'choose.menu'|trans}}</span>
            </a>
        </div>
    </section>

{% endblock %}

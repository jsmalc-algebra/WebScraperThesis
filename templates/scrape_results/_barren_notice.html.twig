{% if useRenderWarningBox  %}

    {% if browser_rendered %}

        {# Already loaded with the headless browser and still barren: don't offer it again #}
        <div class="alert alert-info mb-4" role="status">
            <h2 class="alert-heading h5">{{ 'barren_browser_title.results'|trans }}</h2>
            <p class="mb-0">{{ 'barren_browser_text.results'|trans }}</p>
        </div>

    {% else %}

        <div class="alert alert-warning d-flex flex-column gap-2 mb-4" role="alert">
            <div>
                <h2 class="alert-heading h5">{{ 'barren_title.results'|trans }}</h2>
                <p class="mb-0">{{ 'barren_text.results'|trans }}</p>
            </div>

            <hr class="my-1">

            {% if is_granted('ROLE_PREMIUM') %}

                <p class="mb-0">{{ 'barren_premium.results'|trans }}</p>
                <a href="{{ path('app_scrape_results', {premiumMode: true}) }}"
                   class="btn btn-primary align-self-start">
                    {{ 'render_browser.results'|trans }}
                </a>

            {% else %}

                <p class="mb-0">{{ 'barren_free.results'|trans }}</p>
                <a href="{{ path('app_user_tier', {'username': app.user.userIdentifier}) }}"
                   class="btn btn-primary align-self-start">
                    {{ 'upgrade.results'|trans }}
                </a>

            {% endif %}
        </div>

    {% endif %}

{% endif %}

{% extends 'base.html.twig' %}

{% block title %}{{ 'title.URL_form'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'h1.URL_form'|trans }}</h1>

    {% set linkErrors = linkInputForm.link.vars.errors %}
    {% set formErrors = linkInputForm.vars.errors %}

    {# Error banner: field-level and form-level errors #}
    {% if linkErrors|length or formErrors|length %}
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
            <svg class="bi flex-shrink-0" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
            </svg>
            <div>
                {% for error in formErrors %}
                    <div>{{ error.message }}</div>
                {% endfor %}
                {% for error in linkErrors %}
                    <div>{{ error.message }}</div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {{ form_start(linkInputForm) }}
    <div class="form-floating mb-3">
        {{ form_widget(linkInputForm.link, {
            attr: {
                class: 'form-control' ~ (linkErrors|length ? ' is-invalid' : ''),
                placeholder: 'label.URL_form'|trans
            }
        }) }}
        {{ form_label(linkInputForm.link, 'label.URL_form'|trans) }}
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2">{{ 'scrape.URL_form'|trans }}</button>
    {{ form_end(linkInputForm) }}
{% endblock %}

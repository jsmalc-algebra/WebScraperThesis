<form method="post" action="{{ path('app_user_delete', {'username': user.username}) }}" onsubmit="return confirm({{ 'delete_confirmation.user'|trans }});">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-danger">{{ 'delete.user'|trans }}</button>
</form>

{% extends 'base.html.twig' %}

{% block title %}{{ 'index.user'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'index.user'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>{{ 'username.user'|trans }}</th>
            <th>{{ 'roles.user'|trans }}</th>
            <th>{{ 'profile.user'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.username }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>
                    <a href="{{ path('app_user_show', {'username': user.username}) }}">{{ 'goto_profile.user'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">{{ 'no_records.user' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_user_new') }}" class="btn btn-primary">{{ 'new.user'|trans }}</a>
{% endblock %}
